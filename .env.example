# ---- bource-mcp configuration ----
# All optional. Never commit real values.

# Where encrypted sessions / cache live (default: ~/.bource-mcp)
# BOURCE_DATA_DIR=C:\Users\you\.bource-mcp

# Encryption key for the session store. If unset, a key file is generated
# once in BOURCE_DATA_DIR (keep it safe; losing it invalidates saved sessions).
# BOURCE_SESSION_KEY=change-me-32-bytes-secret

# TSE investor portal used by the guarded browser adapter.
# Default: https://my.tsetmc.com (TSE investor portal)
# BOURCE_PORTAL_URL=https://my.tsetmc.com

# Extra hostnames the guarded browser may visit (comma separated, suffixes
# match: "tse.ir" allows any *.tse.ir subdomain)
# Default: my.tsetmc.com,tsetmc.com,tse.ir,webgw.tse.ir
# BOURCE_ALLOW_HOSTS=my.tsetmc.com,tsetmc.com

# Set to anything to silence startup banner (kept out of MCP stdio anyway)
# BOURCE_LOG=1

# Suppress the automatic "page_open" guard that requires an allowlisted host
# (do NOT disable in production; used for local testing only)
# BOURCE_ALLOW_ALL_HOSTS=0
